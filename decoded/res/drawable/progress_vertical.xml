<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="6.0dp" />
            <solid android:color="#fff9e7" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip android:gravity="bottom" android:clipOrientation="vertical">
            <shape>
                <corners android:topLeftRadius="6.0dp" android:topRightRadius="6.0dp" />
                <solid android:color="#d0d0d0" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip android:gravity="bottom" android:clipOrientation="vertical">
            <shape>
                <corners android:topLeftRadius="6.0dp" android:topRightRadius="6.0dp" />
                <solid android:color="#fed55e" />
            </shape>
        </clip>
    </item>
</layer-list>
