<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:right="5.0dp">
                <bitmap android:src="@mipmap/ic_rb_white" />
            </item>
        </layer-list>
    </item>
    <item android:state_selected="false">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:right="5.0dp">
                <bitmap android:src="@mipmap/ic_rb_yellow" />
            </item>
        </layer-list>
    </item>
</selector>
